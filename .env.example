# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these, `npm run dev` falls back to local development profiles
# and production builds refuse to let anyone in.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Allow the local (non-Google) profiles in a production build, e.g. for a demo.
# Never enable this for a real deployment: local profiles are not authenticated.
# VITE_ALLOW_LOCAL_AUTH=true

# Development only, without Supabase: local profiles go through the offline
# cache and a fake server stored in localStorage (with latency, and failing
# while the browser is offline), to work on sync without a real backend.
# VITE_SIMULATE_SYNC=true
